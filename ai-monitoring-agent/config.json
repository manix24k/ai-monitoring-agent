    "target_branch": "develop_mercury",
    "fix_mode": "source_fix",
    "eligibility_mode": "permissive",
    "allow_analysis_report_pr": true,
    "ignore_issue_patterns": [
      "(?i)insertpropertypendingcheckouttaskjob\\s*-->",
      "(?i)insertpropertypendingcheckintaskjob\\s*-->",
      "(?i)quartzscheduler_.*misfirehandler",
      "(?i)localdatasourcejobstore.*misfirehandler.*couldn't retrieve trigger",
      "(?i)org\\.quartz\\.jobpersistenceexception",
      "(?i)java\\.net\\.connectexception",
      "(?i)connection refused",
      "(?i)connectexception.*connection refused",
      "(?i)failed to connect",
      "(?i)connection\\s+refused\\s*\\(",
      "(?i)connection\\s+refused\\s+at\\s+java",
      "(?i)failed\\s+to\\s+connect.*ai-monitoring-agent"
